# DeepSeek API Key
# 从 https://platform.deepseek.com/ 获取
# 使用方法：复制本文件为 .env（cp .env.example .env），然后填入你的 key
DEEPSEEK_API_KEY=sk-在此填入你的key
# CORS 允许的前端来源（逗号分隔）
# 本地开发留空即可；生产部署填 http://你的公网IP
CORS_ORIGINS=
# arXiv API 专用代理（可选）
# 服务器直连 export.arxiv.org 被 reset（ConnectionResetError 104）时必填，
# 指向一个能出网的 HTTP 代理，例如 http://127.0.0.1:7890
# 只影响 arXiv 抓取，DeepSeek 调用不受影响；本地开发留空即可
ARXIV_PROXY=